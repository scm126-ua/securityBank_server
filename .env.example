# Copia este fichero como .env y ajusta los valores:
#   cp .env.example .env
# El fichero .env está excluido de Git: no subas nunca contraseñas al repositorio.
# Estos valores son SOLO de ejemplo para desarrollo local.

# --- PostgreSQL ---
POSTGRES_DB=securitybank
POSTGRES_USER=securitybank
POSTGRES_PASSWORD=cambia_esta_password_dev
# Puerto de tu ordenador para conectar con DBeaver (localhost:5432).
# Cámbialo (por ejemplo a 5433) si ya tienes otro PostgreSQL instalado en el 5432.
POSTGRES_HOST_PORT=5432
# Contraseña del rol securitybank_app, con privilegios mínimos, que usa el backend.
# Debe ser distinta de POSTGRES_PASSWORD.
APP_DB_PASSWORD=cambia_esta_password_app_dev

# --- Migraciones y backend ---
# Docker Compose sustituye ${...} por los valores definidos arriba.
# "db" es el nombre del servicio de PostgreSQL dentro de la red de Docker.
# Si la contraseña contiene caracteres especiales (@ : / ? #), deben ir
# codificados en formato URL (por ejemplo, @ se escribe %40).
# sslmode=disable solo es aceptable en desarrollo local.
# Las migraciones usan el propietario de las tablas...
MIGRATE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
# ...y el backend, el rol de la aplicación, que no puede cambiar el esquema ni la auditoría.
DATABASE_URL=postgres://securitybank_app:${APP_DB_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=disable
BACKEND_PORT=8080
# Puerto HTTPS público del proxy local.
HTTPS_PORT=8443
# La clave RSA-3072 se genera automáticamente y nunca debe subirse a Git.
SERVER_KEY_PATH=.keys/server_private.pem
# Huella SHA-256 de esa clave (aparece en los logs del backend). Si se define, el
# frontend se niega a iniciar sesión con un servidor que presente otra clave.
SERVER_KEY_FINGERPRINT=

# Origen del frontend permitido por CORS.
CORS_ORIGIN=https://localhost:8443

# --- Claves de cifrado en reposo (Base64 de 32 bytes) ---
# Genera una clave DISTINTA para cada uso:
#   openssl rand -base64 32
# DATA_ENCRYPTION_KEY cifra el DNI y el IBAN en PostgreSQL. Si la cambias sin
# rotar los datos, los valores existentes dejan de poder descifrarse.

DATA_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=

# Usuario administrador
ADMIN_EMAIL=admin@securitybank.com
ADMIN_PASSWORD=una-contraseña-larga-y-fuerte
ADMIN_DNI=12345678Z